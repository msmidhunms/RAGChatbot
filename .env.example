# Copy this file to .env and fill in only what your config uses.

# LLM / embedding providers (Gemini is the default for both)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Vector stores
QDRANT_API_KEY=
PG_CONN=postgresql+psycopg://user:password@localhost:5432/rag

# LangSmith tracing (optional; also enabled by observability.langsmith: true)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-chatbot

# Optional: default config file and overrides
# RAG_CONFIG=configs/default.yaml
# RAG__RETRIEVAL__K=10
