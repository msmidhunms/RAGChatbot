# Copy to .env and fill in only what your config uses.

# LLM / embedding providers
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Vector stores
QDRANT_API_KEY=
PG_CONN=postgresql+psycopg://user:password@localhost:5432/rag

# Tracing (observability.langsmith: true)
LANGSMITH_API_KEY=

# Optional: default config file and overrides
# RAG_CONFIG=configs/default.yaml
# RAG__RETRIEVAL__K=10
